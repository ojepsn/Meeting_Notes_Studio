{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for NoteSmith Desktop",
  "windows": ["main", "notesmith-todos"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "updater:default"
  ]
}
