{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteSmith Desktop",
  "version": "0.1.93",
  "identifier": "com.notesmith.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteSmith Desktop",
        "width": 1500,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/agent-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/ojepsn/Meeting_Notes_Studio/releases/latest/download/latest-native.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5OTlEMjQ4OEM5MEM5MjEKUldRaHlaQ01TTktaMlVzTEljM3AzZjJqOXNBTkhuYTJDV1ZZVlhER0hLaGVSaEY1WlY0RWtwK04K"
    }
  }
}
